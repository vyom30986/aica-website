# ---- Required in production ----
# Public site URL (used for canonical links, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://aicaglobal.in

# Neon Postgres connection string (Vercel → Storage → Neon adds this automatically)
DATABASE_URL=

# Password for the /admin leads dashboard (use a long random string)
ADMIN_PASSWORD=
# Optional separate secret for signing the admin cookie (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# ---- Email alerts for every new lead (free at resend.com) ----
RESEND_API_KEY=
# Where alerts go (comma-separated)
LEAD_NOTIFY_TO=adaptiveintelligentcareapp@gmail.com
# After verifying aicaglobal.in in Resend, e.g. "AICA <hello@aicaglobal.in>"
RESEND_FROM=
# "on" to also email a thank-you to people who sign up (needs a verified domain)
LEAD_CONFIRMATION=off

# ---- Optional ----
# Google Tag Manager — only loads after the visitor accepts cookies
NEXT_PUBLIC_GTM_ID=GTM-NGBF7H39
# Where the old prototypes live once the domain moves (e.g. https://demo.aicaglobal.in/demo)
NEXT_PUBLIC_DEMO_URL=https://aicaglobal.in/demo
